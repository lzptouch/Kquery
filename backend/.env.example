# 千问平台（阿里云百炼 / DashScope）API Key。
# 留空或 MODEL_PROVIDER=mock 时使用内置 Mock 实现（可跑通全链路功能测试）。
DASHSCOPE_API_KEY=

# auto: 有 Key 走千问平台，无 Key 走 Mock；也可强制 dashscope / mock
MODEL_PROVIDER=auto

# 模型档位（同接口切换，只改名称）
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
TEMPERATURE=0

# RAG 参数（阶段 1 推荐值）
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4

# 数据目录（上传文档与元数据落盘位置）
DATA_DIR=./data

# 向量库：milvus（standalone 服务 / lite 文件）| faiss（本地文件）
# standalone 部署见 deploy/milvus（docker compose up -d）
VECTOR_STORE=milvus
KQUERY_MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kquery_chunks

# 云端调用治理
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# 上传限制
MAX_UPLOAD_MB=50

# 阶段 9：企业护栏
# 认证（静态凭证表，仅本地演示；生产应接统一认证中心，本系统只校验不签发）
AUTH_ENABLED=false
# 令牌表：{"<token>": {"user_id":"zhangsan","tenant_id":"default","roles":["hr"],"groups":[]}}
AUTH_TOKENS_JSON=
# 用户目录：[{"user_id":"zhangsan","tenant_id":"default","roles":["hr"],"groups":[],"enabled":true}]
AUTH_USERS_JSON=
# 文档级 ACL（检索前租户过滤 + 检索后 ACL 双保险；默认拒绝）
ACL_ENABLED=true
# 输出侧敏感词扫描（长词优先 + 掩码）
SENSITIVE_SCAN_ENABLED=true
# 租户滑动窗口配额
QUOTA_PER_MINUTE=60
QUOTA_PER_DAY=10000
# 平台侧配额（账号级上游约束，全租户共享）：0 = 只统计不拦截
PLATFORM_QUOTA_PER_DAY=0
PLATFORM_QUOTA_WARN_RATIO=0.8
# 默认租户（未携带租户头时的归属）
DEFAULT_TENANT_ID=default
