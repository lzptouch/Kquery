# KQuery Pro 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置
# 注意：分组配置使用前缀（APP_/DB_/LLM_/RAG_/SEC_/STORAGE_/PERF_/IMG_/ALIYUN_/ELK_）

# ========== 服务基础配置 (APP_ 前缀) ==========
APP_DEBUG=false
APP_ENVIRONMENT=development
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_CORS_ORIGINS=*
APP_ENABLE_METRICS=false

# ========== 数据库配置 (DB_ 前缀) ==========
DB_MILVUS_HOST=localhost
DB_MILVUS_PORT=19530
DB_MILVUS_USER=
DB_MILVUS_PASSWORD=
DB_EMBEDDING_DIMENSION=4096
DB_NEO4J_URI=bolt://localhost:7687
DB_NEO4J_USER=neo4j
DB_NEO4J_PASSWORD=SecureNeo4j@2026
DB_NEO4J_DATABASE=neo4j
DB_REDIS_URL=redis://localhost:6379/0
DB_REDIS_MAX_CONNECTIONS=100
DB_MONGODB_URL=mongodb://localhost:27017/kquery_logs

# ========== LLM 配置 (LLM_ 前缀) ==========
LLM_EMBEDDING_MODEL_NAME=text-embedding-v3
LLM_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_API_KEY=your-api-key-here
LLM_EMBEDDING_TIMEOUT=120
LLM_RERANK_MODEL_NAME=gte-rerank
LLM_RERANK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_RERANK_API_KEY=your-api-key-here

# ========== RAG 配置 (RAG_ 前缀) ==========
RAG_INITIAL_TOP_K=15
RAG_TOP_K=5
RAG_USE_HYDE=true
RAG_USE_RRF=true
RAG_USE_RERANKER=true
RAG_USE_TIME_DECAY=true
RAG_RRF_K=60
RAG_TIME_DECAY_HALF_LIFE_DAYS=30.0
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ========== 安全配置 (SEC_ 前缀) ==========
SEC_API_KEY_ENABLED=false
SEC_API_KEYS=
SEC_MAX_FILE_SIZE_MB=100

# ========== 存储配置 (STORAGE_ 前缀) ==========
STORAGE_TYPE=local
STORAGE_UPLOAD_DIR=./documents
STORAGE_AUTO_CLEANUP=true
STORAGE_FILE_RETENTION_DAYS=30
STORAGE_MINIO_ENDPOINT=localhost:9000
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_BUCKET=kquery-documents
STORAGE_MINIO_SECURE=false

# ========== 性能配置 (PERF_ 前缀) ==========
PERF_QUERY_TIMEOUT=30
PERF_PROCESS_TIMEOUT=300
PERF_BATCH_MAX_CONCURRENCY=3
PERF_EMBEDDING_MAX_CONCURRENCY=5
PERF_EMBEDDING_BATCH_SIZE=10
PERF_RATE_LIMIT_REQUESTS=100
PERF_RATE_LIMIT_WINDOW_SECONDS=60

# ========== 图像配置 (IMG_ 前缀) ==========
IMG_ENABLE_IMAGE_UNDERSTANDING=true
IMG_VISION_MODEL=qwen-vl-plus
IMG_DESCRIPTION_LEVEL=standard
IMG_CACHE_ENABLED=true
IMG_CACHE_DIR=./cache/images
IMG_MIN_IMAGE_WIDTH=100
IMG_MIN_IMAGE_HEIGHT=100

# ========== 阿里云配置 (ALIYUN_ 前缀) ==========
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=your-api-key-here
ALIYUN_REGION=cn-hangzhou

# ==================== ELK 日志服务 (ELK_ 前缀) ====================
ELK_ENABLED=false
ELK_LOGSTASH_HOST=localhost
ELK_LOGSTASH_PORT=5045
ELK_INDEX_NAME=kquery-logs
ELK_ENVIRONMENT=development
ELK_BATCH_SIZE=100
ELK_FLUSH_INTERVAL=2.0
