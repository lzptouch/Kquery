# 千问平台（阿里云百炼 / DashScope）API Key。
# 留空或 MODEL_PROVIDER=mock 时使用内置 Mock 实现（可跑通全链路功能测试）。
DASHSCOPE_API_KEY=

# auto: 有 Key 走千问平台，无 Key 走 Mock；也可强制 dashscope / mock
MODEL_PROVIDER=auto
# OCR provider：**一律云服务 API**。auto（跟随 MODEL_PROVIDER）| dashscope | mock。
# 不支持 local / onnx / paddleocr 等本地或自部署模型（架构约束，见 app/services/parsers/ocr.py）。
OCR_PROVIDER=auto

# 模型档位（同接口切换，只改名称）
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
TEMPERATURE=0

# RAG 参数（阶段 1 推荐值）
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4

# 数据目录（上传文档与元数据落盘位置）
DATA_DIR=./data

# 向量库：milvus（standalone 服务 / lite 文件）| faiss（本地文件）
# standalone 部署见 deploy/milvus（docker compose up -d）
VECTOR_STORE=milvus
KQUERY_MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kquery_chunks

# 云端调用治理
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# 上传限制
MAX_UPLOAD_MB=50

# ---- F2 语音输入（两条通路，后端代持凭据）----
# 通路 A：火山 STS（前端直连火山 WebSocket 流式识别）
# 密钥由后端持有，前端只拿 STS token（密钥绝不能进前端产物）。
# 留空 = 该通路不可用。
VOLC_APPID=
VOLC_ACCESS_KEY=
# 语音识别通用集群
VOLC_SPEECH_CLUSTER=volcengine_input_common
# STS token 有效期（秒）
SPEECH_STS_DURATION_S=300

# 通路 B：后端 ASR 代理（浏览器录 PCM → POST /speech/transcribe → 后端转写）
# 这是**默认通路**：不需要火山 APPID/AccessKey，也不依赖闭源前端 SDK。
# provider：dashscope（百炼原生，qwen3-asr-flash/fun-asr-flash）
#          | openai（任何兼容 /v1/audio/transcriptions 的服务）
#          | none（关闭语音转写）
SPEECH_ASR_PROVIDER=dashscope
SPEECH_ASR_MODEL=qwen3-asr-flash
# 自定义转写端点（留空 = 用 provider 默认地址）
SPEECH_ASR_BASE_URL=
# 转写用 API Key（留空 = 复用 DASHSCOPE_API_KEY）
SPEECH_ASR_API_KEY=
# 单次转写音频上限（MB）与上游超时（秒）
SPEECH_MAX_AUDIO_MB=10
SPEECH_ASR_TIMEOUT_S=60

# ---- F4 快问（单文档「上传即问」）----
# 临时文档 TTL（秒，默认 2 小时）与规模上限
QUICK_ASK_TTL_S=7200
QUICK_ASK_MAX_PAGES=20
QUICK_ASK_MAX_MB=20

# ---- F6 共享存储（Redis）----
# 留空 = 进程内（单副本）。多副本必须配 Redis，否则限流/配额实际额度 × 副本数。
REDIS_URL=
REDIS_KEY_PREFIX=kquery:
# 语义缓存后端：auto（有 Redis 用 Redis）/ memory / redis
# redis 模式下 REDIS_URL 为空会在**启动期**直接失败（配置错误不该拖到运行期）
CACHE_BACKEND=auto

# 阶段 9：企业护栏
# 认证（静态凭证表，仅本地演示；生产应接统一认证中心，本系统只校验不签发）
AUTH_ENABLED=false
# 令牌表：{"<token>": {"user_id":"zhangsan","tenant_id":"default","roles":["hr"],"groups":[]}}
AUTH_TOKENS_JSON=
# 用户目录：[{"user_id":"zhangsan","tenant_id":"default","roles":["hr"],"groups":[],"enabled":true}]
AUTH_USERS_JSON=

# ---- 账号密码登录档（第四档：登录端点自签发上面的 HS256 令牌）----
# 全部默认关闭，不改变任何现有部署的行为路径。
# 开启 AUTH_PASSWORD_ENABLED 时 AUTH_JWT_SECRET 变为必需（签发与验签共用一把密钥）。
AUTH_PASSWORD_ENABLED=false
# 自助注册总开关。新账号一律最小权限（sales），请求体里的 roles 一律丢弃。
AUTH_REGISTRATION_ENABLED=false
# 登录令牌有效期（秒）。默认 900 = 15 分钟；停用/降权另有 get_principal 目录复核即时生效。
AUTH_SESSION_TTL_S=900
# 首次启动为 admin 写入口令（仅当 admin 尚无口令时生效，之后不再覆盖）。
# 若既没有它、用户目录里也没有任何口令，服务会**拒绝启动**——宁可不启动，
# 也不要出现"服务全绿但没人能登录"这种最难排查的状态。
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# HS256 签名密钥（>=16 字符，生产应由 Secret 注入而非写进本文件）
AUTH_JWT_SECRET=
# 文档级 ACL（检索前租户过滤 + 检索后 ACL 双保险；默认拒绝）
ACL_ENABLED=true
# 输出侧敏感词扫描（长词优先 + 掩码）
SENSITIVE_SCAN_ENABLED=true
# 租户滑动窗口配额
QUOTA_PER_MINUTE=60
QUOTA_PER_DAY=10000
# 平台侧配额（账号级上游约束，全租户共享）：0 = 只统计不拦截
PLATFORM_QUOTA_PER_DAY=0
PLATFORM_QUOTA_WARN_RATIO=0.8
# 默认租户（未携带租户头时的归属）
DEFAULT_TENANT_ID=default
